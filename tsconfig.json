{
    "compilerOptions": {
        "target": "esnext",
        "rootDir": "src",
        "declaration": true,
        "sourceMap": true,
        "types": ["node"],
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "incremental": true,
        "noEmit": true
    },
    "exclude": ["node_modules", "test"],
    "include": ["src"]
}
